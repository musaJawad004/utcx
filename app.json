{
  "expo": {
    "name": "UTCX",
    "slug": "utcx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "utcx",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.musajawad.utcx",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": false
      }
    },
    "android": {
      "package": "com.musajawad.utcx",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#F2F0EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "navigationBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#F2F0EA"
      }
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-splash-screen", { "backgroundColor": "#F2F0EA", "image": "./assets/splash-icon.png", "imageWidth": 92 }],
      ["expo-location", { "locationWhenInUsePermission": "UTCX uses your location to identify your current city and timezone." }],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.musajawad.utcx.widgets",
          "groupIdentifier": "group.com.musajawad.utcx",
          "enableAndroid": true,
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": [
            {
              "name": "UTCXSingleClock",
              "displayName": "UTCX City",
              "description": "A precise single-city clock.",
              "supportedFamilies": ["systemSmall", "accessoryCircular", "accessoryRectangular", "accessoryInline"],
              "contentMarginsDisabled": true,
              "android": { "minWidth": 110, "minHeight": 110, "targetCellWidth": 2, "targetCellHeight": 2, "resizeMode": "both" }
            },
            {
              "name": "UTCXThreeCity",
              "displayName": "UTCX Three Cities",
              "description": "Three world clocks at a glance.",
              "supportedFamilies": ["systemMedium"],
              "contentMarginsDisabled": true,
              "android": { "minWidth": 250, "minHeight": 110, "targetCellWidth": 4, "targetCellHeight": 2, "resizeMode": "both" }
            },
            {
              "name": "UTCXWorldTime",
              "displayName": "UTCX World Time",
              "description": "A large, resizable world-time instrument.",
              "supportedFamilies": ["systemLarge"],
              "contentMarginsDisabled": true,
              "android": { "minWidth": 250, "minHeight": 220, "targetCellWidth": 4, "targetCellHeight": 4, "resizeMode": "both" }
            }
          ]
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
